---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthYear } from '../lib/site';

const certs = (await getCollection('certifications')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Certifications" description="Certifications, coursework, and languages.">
  <h1>Certifications</h1>

  {
    certs.length > 0 ? (
      <ul class="plain-list certs">
        {certs.map(({ data }) => (
          <li class={data.badge ? 'has-badge' : undefined}>
            {data.badge && <Image src={data.badge} alt={`${data.name} badge`} width={40} densities={[1, 2]} class="badge" />}
            {data.url ? (
              <a href={data.url} target="_blank" rel="noopener noreferrer">
                {data.name}
              </a>
            ) : (
              <span>{data.name}</span>
            )}
            <div class="muted small">
              {data.issuer} · {monthYear(data.date)}
              {data.status === 'in-progress' && ' (in progress)'}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Coming soon.</p>
    )
  }

  <h2>Languages</h2>
  <p>Korean and Urdu. Lived in Pakistan (7 yrs) and Taiwan (2 yrs).</p>

  <p class="muted small credit">
    Website inspired by <a href="https://paulgraham.com" target="_blank" rel="noopener noreferrer">paulgraham.com</a>.
  </p>
</BaseLayout>

<style>
  .has-badge {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 0.6rem;
    align-items: center;
  }
  .has-badge .badge {
    grid-row: span 2;
    width: 40px;
    height: auto;
    border-radius: 5px;
  }
  .certs li + li {
    margin-top: 0.9rem;
  }
  .small {
    font-size: 0.875rem;
  }
  .credit {
    margin-top: 3rem;
  }
</style>
