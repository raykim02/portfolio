---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthYear } from '../lib/site';
import wheatonLogo from '../assets/logos/wheatoncollege.jpg';

const roles = (await getCollection('experience')).sort(
  (a, b) => b.data.start.valueOf() - a.data.start.valueOf(),
);
---

<BaseLayout title="Experience" description="Work experience, tools, domain, and education.">
  <h1>Experience</h1>

  {
    roles.map(({ data }) => (
      <div class="role">
        <p class="company">
          {data.logo && <Image src={data.logo} alt="" width={24} height={24} densities={[1, 2]} />}
          <b>{data.company}</b>
        </p>
        <p>
          {data.title}{' '}
          <span class="muted dates">
            · {monthYear(data.start)} – {data.end ? monthYear(data.end) : 'Present'}
          </span>
        </p>
        <p>{data.domain}</p>
        {data.tools.length > 0 && <p>Tools: {data.tools.join(', ')}</p>}
      </div>
    ))
  }

  <h2>Education</h2>
  <p class="company">
    <Image src={wheatonLogo} alt="" width={24} height={24} densities={[1, 2]} />
    <b>Wheaton College</b>, B.S. Computer Science, Economics minor <span class="muted">· May 2024</span>
  </p>
</BaseLayout>

<style>
  /* Each role is one tight block; space goes between roles, not lines. */
  .role + .role {
    margin-top: 1.4rem;
  }
  .role p {
    margin: 0;
  }
  /* Keep a date range on one line; the whole range wraps instead. */
  .dates {
    white-space: nowrap;
  }
  .company {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem !important;
  }
  .company img {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    flex: none;
  }
  h2 + .company {
    display: block;
  }
  h2 + .company img {
    vertical-align: -6px;
    margin-right: 0.45rem;
  }
</style>
