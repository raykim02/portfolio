---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title="About" description={`About ${SITE.name}: background, resume, and contact.`}>
  <h1>About</h1>

  <p>
    I've worked across product, software, and data: from product management in data centers, to
    software engineering in finance, to database development in the crude oil midstream sector. Data engineering is where these threads meet, and it's what I'm pursuing next. Outside of
    work, I play pickup basketball and do freehand drawing.
  </p>

  <h2>Resume</h2>
  <!-- TODO: import url from ../lib/site and add href={url('/resume.pdf')} target="_blank" rel="noopener noreferrer" once public/resume.pdf is uploaded -->
  <p><a class="resume-link">Resume (PDF)</a></p>

  <h2>Contact</h2>
  <ul class="plain-list contact">
    <li>
      Email: <button type="button" class="copy-email" data-email={SITE.email} title="Copy email address">{SITE.email}</button>
      <span class="copied muted" role="status" aria-live="polite">(click to copy)</span>
    </li>
    <li>
      LinkedIn: <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">{SITE.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</a>
    </li>
    <li>
      GitHub: <a href={SITE.github} target="_blank" rel="noopener noreferrer">{SITE.github.replace(/^https?:\/\//, '')}</a>
    </li>
  </ul>
</BaseLayout>

<script>
  // Click the email to copy it instead of opening a mail app.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-email')) {
    const status = btn.nextElementSibling as HTMLElement | null;
    const hint = status?.textContent ?? '';
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (status) status.textContent = '(copied)';
      } catch {
        // Clipboard blocked: select the text so the visitor can copy it manually.
        const range = document.createRange();
        range.selectNodeContents(btn);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        if (status) status.textContent = '(press Ctrl+C to copy)';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (status) status.textContent = hint;
      }, 2000);
    });
  }
</script>

<style>
  .contact li + li {
    margin-top: 0.3rem;
  }
  /* Looks like a regular link, but copies instead of opening a mail app. */
  .copy-email {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: copy;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .copy-email:hover {
    text-decoration-thickness: 2px;
  }
  /* No href yet, so style it like a normal link by hand. */
  .resume-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .copied {
    font-size: 0.85rem;
    margin-left: 0.4rem;
  }
</style>
